<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Video Sampler & FX Rack Pro</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body class="bg-zinc-950 text-zinc-100 font-sans p-6">
    <div class="max-w-4xl mx-auto space-y-6">
        <h1 class="text-2xl font-bold tracking-wide flex items-center justify-between">
            <span>Video Sampler & FX Rack</span>
            <button id="btnAudioCtx" class="bg-violet-600 hover:bg-violet-500 text-xs px-3 py-1.5 rounded-lg font-mono transition">⚠️ Activar Audio API</button>
        </h1>
        
        <!-- Input de Video -->
        <input type="file" id="upload" accept="video/*" class="block w-full text-sm text-zinc-400 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-violet-600 file:text-white hover:file:bg-violet-700 cursor-pointer"/>

        <!-- Reproductor -->
        <div class="relative bg-black rounded-xl overflow-hidden shadow-2xl aspect-video flex items-center justify-center border border-zinc-800">
            <video id="videoPlayer" class="w-full h-full object-contain" crossorigin="anonymous" controls></video>
        </div>

        <!-- Controles Principales & Looper -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <!-- Velocidad / Tempo -->
            <div class="bg-zinc-900 p-4 rounded-xl border border-zinc-800 space-y-3">
                <h3 class="text-sm font-semibold text-zinc-400">Transporte & Tempo</h3>
                <div>
                    <label class="block text-xs font-medium mb-1">Velocidad / Pitch: <span id="speedVal">1.0x</span></label>
                    <input type="range" id="speedRange" min="0.25" max="2" step="0.05" value="1" class="w-full accent-violet-500">
                </div>
                <button id="btnCue" class="w-full bg-amber-600 hover:bg-amber-500 font-semibold py-2 px-3 rounded-lg transition text-sm">Marcar CUE</button>
            </div>

            <!-- Sección de Loop (A - B) -->
            <div class="bg-zinc-900 p-4 rounded-xl border border-zinc-800 space-y-3">
                <div class="flex items-center justify-between">
                    <h3 class="text-sm font-semibold text-zinc-400">Sección de Loop (A - B)</h3>
                    <span id="loopStatus" class="text-xs px-2 py-1 rounded bg-zinc-800 text-zinc-400 font-mono">Loop: OFF</span>
                </div>
                <div class="grid grid-cols-3 gap-2">
                    <button id="btnSetIn" class="bg-zinc-800 hover:bg-zinc-700 border border-zinc-700 py-2 px-2 rounded-lg text-xs font-medium transition">
                        Set IN <br><span id="inVal" class="text-[10px] text-zinc-400 font-mono">--:--</span>
                    </button>
                    <button id="btnSetOut" class="bg-zinc-800 hover:bg-zinc-700 border border-zinc-700 py-2 px-2 rounded-lg text-xs font-medium transition">
                        Set OUT <br><span id="outVal" class="text-[10px] text-zinc-400 font-mono">--:--</span>
                    </button>
                    <button id="btnToggleLoop" class="bg-zinc-800 hover:bg-emerald-700 border border-zinc-700 py-2 px-2 rounded-lg text-xs font-medium transition text-emerald-400 hover:text-white">
                        Loop OFF
                    </button>
                </div>
            </div>
        </div>

        <!-- RACK DE EFECTOS AUDIO (Vinilo, Compresor, Reverb, Delay) -->
        <div class="bg-zinc-900 p-5 rounded-xl border border-zinc-800 space-y-4">
            <h3 class="text-sm font-semibold text-zinc-400 border-b border-zinc-800 pb-2">Rack de Efectos de Audio (Web Audio API)</h3>
            
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                
                <!-- EFECTO 1: FILTRO VINILO (Simulador de corte de frecuencias de vinilo antiguo) -->
                <div class="bg-zinc-950 p-3 rounded-lg border border-zinc-800 space-y-2">
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-bold text-violet-400">Filtro Vinilo</span>
                        <input type="checkbox" id="vinylToggle" class="accent-violet-500 w-4 h-4 cursor-pointer">
                    </div>
                    <div>
                        <label class="text-[10px] text-zinc-400 block">Corte Agudos (Cutoff): <span id="vinylCutVal">5000Hz</span></label>
                        <input type="range" id="vinylCutoff" min="500" max="15000" step="100" value="5000" class="w-full accent-violet-500">
                    </div>
                </div>

                <!-- EFECTO 2: COMPRESOR -->
                <div class="bg-zinc-950 p-3 rounded-lg border border-zinc-800 space-y-2">
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-bold text-violet-400">Compresor</span>
                        <input type="checkbox" id="compToggle" class="accent-violet-500 w-4 h-4 cursor-pointer">
                    </div>
                    <div>
                        <label class="text-[10px] text-zinc-400 block">Umbral (Threshold): <span id="compThVal">-24dB</span></label>
                        <input type="range" id="compThreshold" min="-50" max="0" step="1" value="-24" class="w-full accent-violet-500">
                    </div>
                </div>

                <!-- EFECTO 3: DELAY -->
                <div class="bg-zinc-950 p-3 rounded-lg border border-zinc-800 space-y-2">
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-bold text-violet-400">Delay / Echo</span>
                        <input type="checkbox" id="delayToggle" class="accent-violet-500 w-4 h-4 cursor-pointer">
                    </div>
                    <div>
                        <label class="text-[10px] text-zinc-400 block">Mix / Wet: <span id="delayMixVal">30%</span></label>
                        <input type="range" id="delayMix" min="0" max="1" step="0.05" value="0.3" class="w-full accent-violet-500">
                    </div>
                </div>

                <!-- EFECTO 4: REVERB -->
                <div class="bg-zinc-950 p-3 rounded-lg border border-zinc-800 space-y-2">
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-bold text-violet-400">Reverb</span>
                        <input type="checkbox" id="reverbToggle" class="accent-violet-500 w-4 h-4 cursor-pointer">
                    </div>
                    <div>
                        <label class="text-[10px] text-zinc-400 block">Mix / Wet: <span id="reverbMixVal">30%</span></label>
                        <input type="range" id="reverbMix" min="0" max="1" step="0.05" value="0.3" class="w-full accent-violet-500">
                    </div>
                </div>

            </div>
        </div>

        <!-- Pads de CUE -->
        <div>
            <h3 class="text-sm font-semibold text-zinc-400 mb-2">Pads de CUE</h3>
            <div id="cuePads" class="grid grid-cols-4 gap-3"></div>
        </div>
    </div>

    <script>
        const video = document.getElementById('videoPlayer');
        const upload = document.getElementById('upload');
        const speedRange = document.getElementById('speedRange');
        const speedVal = document.getElementById('speedVal');
        const btnCue = document.getElementById('btnCue');
        const cuePads = document.getElementById('cuePads');
        const btnAudioCtx = document.getElementById('btnAudioCtx');

        // Looper elements
        const btnSetIn = document.getElementById('btnSetIn');
        const btnSetOut = document.getElementById('btnSetOut');
        const btnToggleLoop = document.getElementById('btnToggleLoop');
        const inVal = document.getElementById('inVal');
        const outVal = document.getElementById('outVal');
        const loopStatus = document.getElementById('loopStatus');

        let cuePoints = [];
        let loopIn = null;
        let loopOut = null;
        let isLooping = false;

        // --- WEB AUDIO API NODOS ---
        let audioCtx = null;
        let sourceNode = null;
        let vinylFilter = null;
        let compressor = null;
        let delayNode = null;
        let delayFeedback = null;
        let delayWet = null;
        let reverbNode = null;
        let reverbWet = null;
        let masterGain = null;

        function initAudioContext() {
            if (audioCtx) return;
            audioCtx = new (window.AudioContext || window.webkitAudioContext)();

            // 1. Crear origen desde el elemento video
            sourceNode = audioCtx.createMediaElementSource(video);

            // 2. Crear Nodos de Efectos
            // Filtro Vinilo (Biquad Lowpass simulando pérdida de agudos en vinilo viejo)
            vinylFilter = audioCtx.createBiquadFilter();
            vinylFilter.type = 'lowpass';
            vinylFilter.frequency.value = 5000;

            // Compresor
            compressor = audioCtx.createDynamicsCompressor();
            compressor.threshold.setValueAtTime(-24, audioCtx.currentTime);
            compressor.knee.setValueAtTime(30, audioCtx.currentTime);
            compressor.ratio.setValueAtTime(12, audioCtx.currentTime);
            compressor.attack.setValueAtTime(0.003, audioCtx.currentTime);
            compressor.release.setValueAtTime(0.250, audioCtx.currentTime);

            // Delay / Echo
            delayNode = audioCtx.createDelay();
            delayNode.delayTime.value = 0.35; // 350ms
            delayFeedback = audioCtx.createGain();
            delayFeedback.gain.value = 0.4;
            delayWet = audioCtx.createGain();
            delayWet.gain.value = 0.0; // Apagado por defecto

            delayNode.connect(delayFeedback);
            delayFeedback.connect(delayNode);
            delayNode.connect(delayWet);

            // Reverb simulada por convolución de impulso básico o filtro en cascada
            reverbWet = audioCtx.createGain();
            reverbWet.gain.value = 0.0;
            // Para mantenerlo liviano sin descargar archivos externos, usamos un delay corto múltiple simulando ambiente
            let reverbDelay = audioCtx.createDelay();
            reverbDelay.delayTime.value = 0.05;
            let reverbFeedback = audioCtx.createGain();
            reverbFeedback.gain.value = 0.3;
            reverbDelay.connect(reverbFeedback);
            reverbFeedback.connect(reverbDelay);
            reverbDelay.connect(reverbWet);

            masterGain = audioCtx.createGain();
            masterGain.gain.value = 1.0;

            // 3. Ruteo Inicial (Directo sin efectos activos)
            updateAudioRouting();

            btnAudioCtx.textContent = "✔ Audio API Activa";
            btnAudioCtx.className = "bg-emerald-600 text-xs px-3 py-1.5 rounded-lg font-mono";
            audioCtx.resume();
        }

        function updateAudioRouting() {
            if (!audioCtx) return;
            // Desconectar todo antes de rutear
            sourceNode.disconnect();
            
            let curr = sourceNode;

            // Ruta de Vinilo
            if (document.getElementById('vinylToggle').checked) {
                curr.connect(vinylFilter);
                curr = vinylFilter;
            }

            // Ruta de Compresor
            if (document.getElementById('compToggle').checked) {
                curr.connect(compressor);
                curr = compressor;
            }

            // Bifurcación para efectos de tiempo (Delay / Reverb)
            if (document.getElementById('delayToggle').checked) {
                curr.connect(delayNode);
                delayWet.connect(masterGain);
            }
            if (document.getElementById('reverbToggle').checked) {
                // Usamos delay corto como reverb simple
                curr.connect(reverbWet);
                reverbWet.connect(masterGain);
            }

            // Salida principal a los parlantes
            curr.connect(masterGain);
            masterGain.connect(audioCtx.destination);
        }

        btnAudioCtx.addEventListener('click', initAudioContext);

        // Controles de interfaz de efectos
        document.getElementById('vinylToggle').addEventListener('change', updateAudioRouting);
        document.getElementById('compToggle').addEventListener('change', updateAudioRouting);
        
        document.getElementById('vinylCutoff').addEventListener('input', (e) => {
            const val = e.target.value;
            document.getElementById('vinylCutVal').textContent = val + 'Hz';
            if (vinylFilter) vinylFilter.frequency.setValueAtTime(val, audioCtx.currentTime);
        });

        document.getElementById('compThreshold').addEventListener('input', (e) => {
            const val = e.target.value;
            document.getElementById('compThVal').textContent = val + 'dB';
            if (compressor) compressor.threshold.setValueAtTime(val, audioCtx.currentTime);
        });

        document.getElementById('delayToggle').addEventListener('change', (e) => {
            if (delayWet) delayWet.gain.value = e.target.checked ? parseFloat(document.getElementById('delayMix').value) : 0;
            updateAudioRouting();
        });

        document.getElementById('delayMix').addEventListener('input', (e) => {
            const val = e.target.value;
            document.getElementById('delayMixVal').textContent = Math.round(val * 100) + '%';
            if (delayWet && document.getElementById('delayToggle').checked) delayWet.gain.value = val;
        });

        document.getElementById('reverbToggle').addEventListener('change', (e) => {
            if (reverbWet) reverbWet.gain.value = e.target.checked ? parseFloat(document.getElementById('reverbMix').value) : 0;
            updateAudioRouting();
        });

        document.getElementById('reverbMix').addEventListener('input', (e) => {
            const val = e.target.value;
            document.getElementById('reverbMixVal').textContent = Math.round(val * 100) + '%';
            if (reverbWet && document.getElementById('reverbToggle').checked) reverbWet.gain.value = val;
        });

        // --- CARGA DE VIDEO ---
        upload.addEventListener('change', (e) => {
            const file = e.target.files[0];
            if (file) {
                video.src = URL.createObjectURL(file);
                video.load();
                if (audioCtx && audioCtx.state === 'suspended') {
                    audioCtx.resume();
                }
            }
        });

        // Control de velocidad
        speedRange.addEventListener('input', (e) => {
            const val = e.target.value;
            video.playbackRate = val;
            speedVal.textContent = val + 'x';
        });

        // CUEs
        btnCue.addEventListener('click', () => {
            const time = video.currentTime;
            cuePoints.push(time);
            renderCues();
        });

        function renderCues() {
            cuePads.innerHTML = '';
            cuePoints.forEach((time, index) => {
                const btn = document.createElement('button');
                btn.className = 'bg-zinc-800 hover:bg-violet-600 border border-zinc-700 p-3 rounded-xl font-mono text-sm transition flex flex-col items-center justify-center shadow';
                btn.innerHTML = `<span class="text-[10px] text-zinc-400">CUE ${index + 1}</span><span>${time.toFixed(2)}s</span>`;
                btn.addEventListener('click', () => {
                    video.currentTime = time;
                    video.play();
                });
                cuePads.appendChild(btn);
            });
        }

        // --- LOOPER ---
        btnSetIn.addEventListener('click', () => {
            loopIn = video.currentTime;
            inVal.textContent = loopIn.toFixed(2) + 's';
            checkLoopReady();
        });

        btnSetOut.addEventListener('click', () => {
            loopOut = video.currentTime;
            outVal.textContent = loopOut.toFixed(2) + 's';
            checkLoopReady();
        });

        function checkLoopReady() {
            if (loopIn !== null && loopOut !== null && loopIn < loopOut) {
                btnToggleLoop.className = 'bg-zinc-800 hover:bg-emerald-600 border border-zinc-700 py-2 px-2 rounded-lg text-xs font-medium transition text-emerald-400 hover:text-white';
            } else {
                isLooping = false;
                updateLoopUI();
            }
        }

        btnToggleLoop.addEventListener('click', () => {
            if (loopIn === null || loopOut === null || loopIn >= loopOut) return;
            isLooping = !isLooping;
            updateLoopUI();
            if (isLooping && (video.currentTime < loopIn || video.currentTime > loopOut)) {
                video.currentTime = loopIn;
            }
        });

        function updateLoopUI() {
            if (isLooping) {
                loopStatus.textContent = 'Loop: ON';
                loopStatus.className = 'text-xs px-2 py-1 rounded bg-emerald-950 text-emerald-400 font-mono border border-emerald-800';
                btnToggleLoop.className = 'bg-emerald-600 border border-emerald-500 py-2 px-2 rounded-lg text-xs font-medium text-white';
                btnToggleLoop.textContent = 'Loop ON';
            } else {
                loopStatus.textContent = 'Loop: OFF';
                loopStatus.className = 'text-xs px-2 py-1 rounded bg-zinc-800 text-zinc-400 font-mono';
                btnToggleLoop.className = 'bg-zinc-800 hover:bg-emerald-700 border border-zinc-700 py-2 px-2 rounded-lg text-xs font-medium text-emerald-400';
                btnToggleLoop.textContent = 'Loop OFF';
            }
        }

        // Monitor de loop ultrarrápido con compensación de seek
        function monitorLoop() {
            if (isLooping && !video.paused) {
                // Si estamos a menos de 50ms de llegar al final del loop, saltamos de forma preventiva
                if (video.currentTime >= (loopOut - 0.05)) {
                    video.currentTime = loopIn;
                }
            }
            requestAnimationFrame(monitorLoop);
        }
        requestAnimationFrame(monitorLoop);
    </script>
</body>
</html>
